{
    "catalog": "https://minio.carlboettiger.info/public-data/stac/catalog.json",
    "titiler_url": "https://titiler.nrp-nautilus.io",
    "mcp_url": "https://duckdb-mcp.carlboettiger.info/mcp",
    "auto_approve": true,
    "upload_enabled": true,
    "draw_enabled": true,
    "charts": {
        "enabled": true
    },
    "geocoder": {
        "provider": "nominatim",
        "search_box": true
    },
    "geolocate": {
        "button": true,
        "agent_tool": true
    },
    "sidebar": {
        "enabled": true,
        "chat_title": "Chat"
    },
    "view": {
        "center": [
            -98,
            39
        ],
        "zoom": 4
    },
    "llm": {
        "user_provided": true,
        "transcription_model": { "value": "gemma" },
        "default_endpoint": "https://openrouter.ai/api/v1",
        "models": [
            {
                "value": "~deepseek/deepseek-v4-flash-latest",
                "label": "DeepSeek V4 Flash Latest"
            },
            {
                "value": "google/gemini-3.5-flash-lite",
                "label": "Gemini 3.5 Flash Lite"
            },
            {
                "value": "z-ai/glm-5.2",
                "label": "GLM-5.2"
            },
            {
                "value": "anthropic/claude-sonnet-5",
                "label": "Claude Sonnet 5"
            },
            {
                "value": "moonshotai/kimi-k3",
                "label": "Kimi 3"
            }
        ]
    },
    "welcome": {
        "message": "Hi! I can help you explore protected areas, land cover, biodiversity, water, hazards, and demographic data across the United States. Try asking:",
        "examples": [
            "How many acres of GAP Status 1 land does California have?",
            "What's the average irrecoverable carbon in California's GAP 1+2 protected lands?",
            "Find the top 5 states by conservation easement acreage.",
            "Color the fee lands by management type and tell me the top 3 management agencies by acreage."
        ]
    },
    "links": {
        "github": "https://github.com/boettiger-lab/geo-agent-template",
        "docs": "https://boettiger-lab.github.io/geo-agent/",
        "carbon": true
    },
